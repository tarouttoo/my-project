# Copy to .sandcastle/.env and fill in (the wizard does this for you).
# .env is gitignored — never commit it.

# Key for the `starimg` provider configured in pi-config/models.json.
# The Windows environment variable of the same name is the source of truth.
STARIMG_API_KEY=

# Token for the gh CLI inside the sandbox (reading issues).
# Generated on the host with: gh auth token
GH_TOKEN=
